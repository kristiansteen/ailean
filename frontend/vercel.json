{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/((?!assets/|api/).*)",
      "destination": "/$1.html"
    }
  ],
  "redirects": [
    {
      "source": "/ailean-cases",
      "destination": "/ailean-philosophy",
      "permanent": false
    },
    {
      "source": "/ailean-cases.html",
      "destination": "/ailean-philosophy",
      "permanent": false
    }
  ]
}
